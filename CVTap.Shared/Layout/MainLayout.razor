@inherits LayoutComponentBase
@inject IThemeService ThemeService
@implements IDisposable

<div class="app-container @ThemeService.ThemeClass">
    <header class="app-header">
        <div class="brand-wrapper">
            <h1 class="brand-title">
                CV<span class="brand-accent">Tap</span>
            </h1>
            <p class="brand-slogan">Send your CV in a few taps.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" 
                    class="btn-theme-toggle" 
                    title="@(ThemeService.IsDark ? "Switch to Light Mode" : "Switch to Dark Mode")"
                    @onclick="ThemeService.ToggleThemeAsync">
                <span class="theme-icon">@(ThemeService.IsDark ? "☀️" : "🌙")</span>
                <span class="theme-text">@(ThemeService.IsDark ? "Light" : "Dark")</span>
            </button>
            <span class="badge-cvtap badge-default">Local Only</span>
        </div>
    </header>

    <NotificationToast />

    <main class="app-main">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="cvtap-card" style="border-color: #f43f5e; background-color: rgba(244, 63, 94, 0.12); padding: 16px;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong style="color: #fda4af; font-size: 1rem;">⚠️ An Error Occurred</strong>
                        <button class="btn-tap btn-secondary-tap" style="width:auto; min-height: 28px; padding: 2px 10px; font-size: 0.75rem;" 
                                @onclick="() => _errorBoundary?.Recover()">
                            Dismiss / Retry
                        </button>
                    </div>
                    <p style="color: #ffffff; font-size: 0.85rem; font-weight: 600; margin-bottom: 6px;">
                        @ex.Message
                    </p>
                    <div style="background: var(--input-bg, #0b1120); border: 1px solid var(--border-color, #334155); border-radius: 6px; padding: 10px; max-height: 180px; overflow: auto;">
                        <pre style="color: #fda4af; font-size: 0.7rem; margin: 0; white-space: pre-wrap;">@ex.ToString()</pre>
                    </div>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>

    <NavBottom />
</div>

<div id="blazor-error-ui" data-nosnippet style="display: none;">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
        await ThemeService.InitializeAsync();
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}
