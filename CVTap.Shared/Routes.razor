<Router AppAssembly="typeof(Layout.MainLayout).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="cvtap-card text-center py-5">
                <h3>Page Not Found</h3>
                <p style="color: var(--text-secondary);">The requested page does not exist.</p>
                <a href="/" class="btn-tap btn-primary-tap" style="display:inline-flex; width:auto; text-decoration:none;">
                    Go to Send CV
                </a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
