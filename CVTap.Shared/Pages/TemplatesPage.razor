@page "/templates"
@inject IEmailTemplateService TemplateService
@inject IToastService Toast
@inject NavigationManager NavManager

<div class="templates-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0;">Email Templates</h2>
        <button class="btn-tap btn-primary-tap" style="width: auto; min-height: 38px; padding: 6px 14px; font-size: 0.85rem;"
                @onclick='() => NavManager.NavigateTo("/templates/edit")'>
            + New Template
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="cvtap-card text-center py-4">
            <p style="color: var(--text-secondary);">Loading templates...</p>
        </div>
    }
    else
    {
        @foreach (var t in _templates)
        {
            <div class="cvtap-card">
                <div class="cv-card-header mb-2">
                    <div class="cv-card-title-row">
                        <span class="cv-card-title">@t.Title</span>
                        <div class="cv-card-badges">
                            @if (t.IsDefault)
                            {
                                <span class="badge-cvtap badge-default">★ Default</span>
                            }
                            <span class="badge-cvtap badge-lang">@t.Language</span>
                        </div>
                    </div>
                    <div style="font-size: 0.82rem; color: var(--accent-indigo); margin-top: 4px; word-break: break-word;">
                        <strong>Subject:</strong> @t.SubjectTemplate
                    </div>
                </div>

                <div style="font-size: 0.8rem; color: var(--text-secondary); max-height: 60px; overflow: hidden; text-overflow: ellipsis; margin-top: 6px; white-space: pre-wrap;">
                    @t.BodyTemplate
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3 pt-2" style="border-top: 1px solid var(--border-subtle);">
                    <div>
                        @if (!t.IsDefault)
                        {
                            <button class="btn-tap btn-secondary-tap" style="width:auto; min-height: 32px; padding: 4px 10px; font-size: 0.78rem;"
                                    @onclick="() => SetDefaultAsync(t.Id)">
                                Make Default
                            </button>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn-icon" title="Duplicate Template" @onclick="() => DuplicateTemplateAsync(t.Id)">
                            📋
                        </button>
                        <button class="btn-icon" title="Edit Template" @onclick='() => NavManager.NavigateTo($"/templates/edit/{t.Id}")'>
                            ✏️
                        </button>
                        <button class="btn-icon btn-danger-tap" title="Delete Template" @onclick="() => DeleteTemplateAsync(t.Id)">
                            🗑️
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _isLoading = true;
    private List<EmailTemplate> _templates = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplatesAsync();
    }

    private async Task LoadTemplatesAsync()
    {
        _isLoading = true;
        try
        {
            var list = await TemplateService.GetAllAsync();
            _templates = list.ToList();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SetDefaultAsync(Guid id)
    {
        await TemplateService.SetDefaultAsync(id);
        Toast.Success("Default template updated.");
        await LoadTemplatesAsync();
    }

    private async Task DuplicateTemplateAsync(Guid id)
    {
        var dup = await TemplateService.DuplicateAsync(id);
        Toast.Success($"Duplicated as '{dup.Title}'");
        await LoadTemplatesAsync();
    }

    private async Task DeleteTemplateAsync(Guid id)
    {
        if (_templates.Count <= 1)
        {
            Toast.Error("You must keep at least one template.");
            return;
        }

        var deleted = await TemplateService.DeleteAsync(id);
        if (deleted)
        {
            Toast.Success("Template deleted.");
            await LoadTemplatesAsync();
        }
    }
}
